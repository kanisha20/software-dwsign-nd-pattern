<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <context-param>
        <param-name>jdbcUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/tiffindb</param-value>
    </context-param>

    <context-param>
        <param-name>dbUser</param-name>
        <param-value>root</param-value>
    </context-param>

    <context-param>
        <param-name>dbPassword</param-name>
        <param-value>your_password</param-value>
    </context-param>

    <servlet>
        <servlet-name>PlanController</servlet-name>
        <servlet-class>tiffin.controller.PlanController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>PlanController</servlet-name>
        <url-pattern>/plans</url-pattern>
    </servlet-mapping>

    <!-- Opens the JSP form through a public URL; WEB-INF stays protected -->
    <servlet>
        <servlet-name>AddPlanPage</servlet-name>
        <jsp-file>/WEB-INF/views/addPlan.jsp</jsp-file>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddPlanPage</servlet-name>
        <url-pattern>/addPlan</url-pattern>
    </servlet-mapping>

</web-app>
