<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!--
    ============================================================
      WEB.XML — TiffinBox (Q3 — Session Management)
      Updated: staffUser + staffPass context-param add kiye
    ============================================================
    -->

    <!-- ======== DB CREDENTIALS ======== -->
    <context-param>
        <param-name>jdbcUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/tiffindb</param-value>
    </context-param>
    <context-param>
        <param-name>dbUser</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>dbPassword</param-name>
        <param-value>root</param-value>
    </context-param>

    <!-- ======== Q3 TASK 4: Staff Login Credentials ======== -->
    <context-param>
        <param-name>staffUser</param-name>
        <param-value>admin</param-value>
    </context-param>
    <context-param>
        <param-name>staffPass</param-name>
        <param-value>tiffin123</param-value>
    </context-param>

    <!-- ======== WELCOME FILE ======== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
